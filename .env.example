# ── Aplicación ────────────────────────────────────────────────────────────────
PORT=3002

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3100
DB_USER=
DB_PASSWORD=
DB_NAME=ceish_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Cifrado ───────────────────────────────────────────────────────────────────
# Clave AES-256-CBC en base64 (32 bytes decodificados)
ENCRYPTION_KEY=

# ── Correo (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Remitente; en desarrollo se puede usar el sandbox de Resend: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# N20 — deshabilitar envíos reales en desarrollo / CI
# Valor por defecto: habilitado. Poner 'false' para modo dry-run (log sin llamar al SDK).
EMAIL_ENABLED=true

# ── Frontend ───────────────────────────────────────────────────────────────────
# N19 — URL base del frontend para deep-links en correos (pendiente TSK-002-N09)
FRONTEND_URL=https://localhost:4200
