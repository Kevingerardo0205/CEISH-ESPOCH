# ============================================================
# CEISH-ESPOCH — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Base de datos (obligatorias) ---
DB_HOST=               # obligatoria
DB_PORT=               # obligatoria
DB_USERNAME=           # obligatoria
DB_PASSWORD=           # obligatoria
DB_NAME=               # obligatoria

# --- Seguridad JWT (obligatorias) ---
JWT_SECRET=            # obligatoria — mínimo 32 caracteres aleatorios
JWT_REFRESH_SECRET=    # obligatoria — mínimo 32 caracteres aleatorios, distinto a JWT_SECRET

# --- Cifrado AES-256 (obligatoria) ---
ENCRYPTION_KEY=        # obligatoria — clave base64 que decodifique a exactamente 32 bytes

# --- Email (obligatoria en producción) ---
RESEND_API_KEY=        # obligatoria

# --- Almacenamiento S3 (requerida si se usa S3) ---
S3_ACCESS_KEY_ID=      # obligatoria si S3 activo
S3_SECRET_ACCESS_KEY=  # obligatoria si S3 activo

# --- Asistente IA (opcional) ---
GEMINI_API_KEY=        # obligatoria si se usa el módulo ai-assistant

# --- Aplicación ---
PORT=3002
BASE_URL=              # URL base pública (p. ej. https://api.ceish.espoch.edu.ec)
